{
    "compilerOptions": {
        "target": "ES2021",
        "module": "ES2015",
        "strictNullChecks": true,
        "sourceMap": false,
        "rootDir": "./src",
        "outDir": "./dist",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmitOnError": true,
        "noImplicitAny": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "node",
        "declaration": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["./node_modules"]
}
