{
    "compilerOptions": {
        "target": "ES2021",
        "module": "ESNext",
        "strict": true,
        "sourceMap": false,
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "emitDeclarationOnly": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmitOnError": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "node"
    },
    "include": ["src/**/*.ts"]
}
